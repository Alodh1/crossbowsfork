<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == '' and '$(VINTAGE_STORY)' != ''">$(VINTAGE_STORY)</VintageStoryPath>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == ''">$(AppData)\Vintagestory</VintageStoryPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)\VintagestoryAPI.dll</HintPath>
    </Reference>
    <ProjectReference Include="..\..\crossbows.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\..\..\OverhaullibLegacy\Overhaullib.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\..\..\Atlas\src\Atlas.XUnit\Atlas.XUnit.csproj" />
  </ItemGroup>

  <Target Name="StageCrossbowsWithoutAnimationsLibForAtlas" AfterTargets="Build">
    <ItemGroup>
      <_CrossbowsAtlasModFiles Include="..\..\bin\$(Configuration)\Mods\crossbowsfork\**\*.*" />
      <_OverhaullibAtlasModFiles Include="..\..\..\OverhaullibLegacy\bin\$(Configuration)\Mods\overhaulliblegacycompat\**\*.*" />
    </ItemGroup>

    <Error Condition="'@(_CrossbowsAtlasModFiles)' == ''"
           Text="Crossbows build output was not found; cannot stage Atlas mod under test." />
    <Error Condition="'@(_OverhaullibAtlasModFiles)' == ''"
           Text="OverhaullibLegacy build output was not found; cannot stage Atlas dependency under test." />

    <RemoveDir Directories="$(TargetDir)mods\crossbowsfork" />
    <RemoveDir Directories="$(TargetDir)mods\overhaulliblegacycompat" />
    <RemoveDir Directories="$(TargetDir)mods\animationslib" />
    <Delete Files="$(TargetDir)mods\animationslib.zip" />
    <MakeDir Directories="$(TargetDir)mods" />
    <MakeDir Directories="$(TargetDir)mods\crossbowsfork" />
    <MakeDir Directories="$(TargetDir)mods\overhaulliblegacycompat" />

    <Copy SourceFiles="@(_CrossbowsAtlasModFiles)"
          DestinationFiles="@(_CrossbowsAtlasModFiles->'$(TargetDir)mods\crossbowsfork\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_OverhaullibAtlasModFiles)"
          DestinationFiles="@(_OverhaullibAtlasModFiles->'$(TargetDir)mods\overhaulliblegacycompat\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
  </Target>

  <Import Project="..\..\..\Atlas\build\Atlas.E2E.targets" />

</Project>
